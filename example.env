# ==============================================
# Infrastructure Services Configuration
# ==============================================

# PostgreSQL Configuration
PGPOOL_HOST=postgres
PGPOOL_PORT=5432
PGPOOL_USER=gauas_user
PGPOOL_PASSWORD=gauas_password_2026
PGPOOL_DB=gauas_db

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_ADDRESS=redis:6379
REDIS_PASSWORD=redis_password_2026
REDIS_DB=0

# MinIO Configuration
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET_NAME=gauas-bucket
MINIO_USE_SSL=false
MINIO_REGION=us-east-1
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# RabbitMQ Configuration
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=gauas_rabbitmq
RABBITMQ_PASSWORD=rabbitmq_password_2026
RABBITMQ_MANAGEMENT_PORT=15672

# ==============================================
# Backend Services Configuration
# ==============================================

# Authorization Service
AUTHORIZATION_SERVICE_PORT=8081
JWT_SECRET_KEY=your_jwt_secret_key_change_this_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRE=604800
PRIVATE_KEY=your_private_key_for_authorization

# CDN Service
CDN_SERVICE_PORT=8082
CACHE_TIME=3600
CACHE_SIZE=1048576

# Cloud Service
CLOUD_SERVICE_PORT=8083
AUTHORIZATION_SERVICE_URL=http://gau-authorization-service:8080
UPLOAD_SERVICE_URL=http://gau-upload-service:8080

# Upload Service
UPLOAD_SERVICE_PORT=8084
DEFAULT_CHUNK_SIZE=5242880
MAX_CHUNK_SIZE=104857600
TEMP_DIR=/tmp
IMAGE_MAX_SIZE=10485760
FILE_MAX_SIZE=104857600

# ==============================================
# CORS Configuration
# ==============================================
ALLOWED_DOMAINS=http://localhost:3000,http://localhost:8080
GLOBAL_DOMAIN=http://localhost:3000

# ==============================================
# Frontend Configuration
# ==============================================
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8083
NEXT_PUBLIC_AUTHORIZATION_URL=http://localhost:8081
NEXT_PUBLIC_CDN_URL=http://localhost:8082
NEXT_PUBLIC_UPLOAD_URL=http://localhost:8084

# ==============================================
# Monitoring & Observability
# ==============================================
GRAFANA_OTLP_ENDPOINT=https://grafana.gauas.online
SERVICE_NAME=gauas-cloud-stack

# ==============================================
# Environment Configuration
# ==============================================
DEPLOY_ENV=local
GROUP_NAME=gauas-dev
MODE=development

